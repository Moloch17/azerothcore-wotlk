#
#    AnimusForge.Curriculum.Resurrection.*
#        Resurrecting: a seat's own Soulstone or Reincarnation, and revives on allies (companion
#        and party stages). Nobody is revived automatically while a resurrection is possible.

#   the dead wait this long (ms) for a resurrection they can get before solo stages end and
#   owner stages stand them up (the next pull waits too)
AnimusForge.Curriculum.Resurrection.GraceMs = 20000
#   a dead ally the seat resurrected stood up
AnimusForge.Curriculum.Resurrection.ReviveAlly = 1.5

#
#    AnimusForge.Curriculum.Output.*
#        How fast the enemies die: every second an engaged enemy lives costs every seat of the side
#        (dead ones too), in every arena but a raid's.

AnimusForge.Curriculum.Output.Clock = 0.03

#
#    AnimusForge.Curriculum.StandIn.*
#        The "human" stand-in (dungeon-curriculum I7): one seat of a party or raid arena played by a frozen learned
#        partner (the learner's co-op partner pool: an earlier stage's best, this run's snapshots) instead of the
#        policy being trained, so the learned seats learn to play with someone who is not a copy of themselves. It
#        leads or follows and plays the role it wants where its build can (tank, healer or damage); the checkpoint the
#        learner draws is the rest of its style. The style is drawn per episode from a seed (an evaluation's from its
#        seed index). Its row is never trained on. The sim fields one only while the learner has a partner to play it;
#        `forge status` says when it has none.

#   percent of a party or raid arena's training episodes with a stand-in (0 = never). Evaluations have one only in
#   the learner's "with the human stand-in" arm (eval.arms.with_human), in every episode of it. An arena may set its
#   own (ArenaDefinition::StandInShare: the dungeon stages, 20), and the conf may set that per
#   arena: AnimusForge.Curriculum.Arena.<stage>.<arena>.StandInShare
AnimusForge.Curriculum.StandIn.Share = 0
#   percent of styles that lead (only where the party has no owner; a leader sits in seat 0, the group's leader)
AnimusForge.Curriculum.StandIn.LeadChance = 50
#   percent of styles that want to tank, and to heal (the rest deal damage); a build that cannot deals damage
AnimusForge.Curriculum.StandIn.TankChance = 34
AnimusForge.Curriculum.StandIn.HealerChance = 33

