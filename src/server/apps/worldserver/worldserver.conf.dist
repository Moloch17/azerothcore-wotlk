#                     |  0 |   Grey |            Poor |
#                     |  1 |  White |          Common |
#                     |  2 |  Green |        Uncommon |
#                     |  3 |   Blue |            Rare |
#                     |  4 | Purple |            Epic |
#                     |  5 | Orange |       Legendary |
#                     |  6 |    Red |        Artifact |
#                     |  7 |   Gold | Bind to Account |
#        Default:     3

ItemDelete.Quality = 3

