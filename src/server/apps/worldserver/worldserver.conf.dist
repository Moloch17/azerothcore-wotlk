###################################################################################################

###################################################################################################
# CLUSTER SETTINGS
#
# This feature is experimental and still under development. It enables cluster mode, allowing multiple
# worldservers to run for a single realm, distributing the load between them. Alongside worldservers,
# additional services are required for proper functionality. If you encounter any issues, please report
# them to the ToCloud9 project: https://github.com/walkline/ToCloud9.
#
#    Cluster.Enabled
#        Description: Enables/disables cluster mode.
#                     SECURITY: in cluster mode the ToCloud9 gateway is the trusted
#                     authentication boundary. This worldserver then skips session-key
#                     digest verification, packet encryption, warden, IP/country locks,
#                     ban and minimum-security-level enforcement, and the
#                     character-ownership check on login. The worldserver port must
#                     only be reachable by the gateway, never directly by players.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Cluster.Enabled=0

#
#    Cluster.AvailableMaps
#        Description: List of available maps id on this server.
#        Examples:    "" - (Can handle any map)
#                     "0,1,573"

Cluster.AvailableMaps=""

#
#    Cluster.IsCrossrealm
#        Description: Enables cross-realm functionality for a cross-realm setup.
#                     When enabled, a connection to a MySQL cross-realm reverse proxy is required.
#        Default: 0 - (Disabled)
#                 1 - (Enabled)

Cluster.IsCrossrealm=0

#
###################################################################################################

###################################################################################################
#                                                                                                 #
# CLUSTER SETTINGS END                                                                            #
#                                                                                                 #
###################################################################################################

###################################################################################################
# FORGE (the in-process training host; formerly mod-animus-forge)
#
#    Every AnimusForge.* key. A legacy modules/mod_animus_forge.conf next to this file is still read
#    after it and overrides these values.
#
###################################################################################################
# GENERAL
#
#    AnimusForge.Enable
#        Description: Enable the module. When disabled it creates no bots, opens no socket and
#                     every hook returns immediately.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

AnimusForge.Enable = 1

#
#    AnimusForge.OutputDir
#        Description: Where training writes its data: runs/<scenario>/ (checkpoints, metrics, evaluation)
#                     and layouts/<scenario>/ (each model's layout manifest and the stage's stage.json).
#                     Relative to the directory of worldserver.conf, or absolute. The Docker ac-worldserver
#                     service sets it to /azerothcore/var/animus-forge.
#        Default:     "" - (the learner's directory, the module's python/)

AnimusForge.OutputDir = ""

###################################################################################################
# QUEUE
#
#    AnimusForge.Queue
#        Description: Comma-separated scenarios `forge start` trains one after another when it is given
#                     none. The sim starts idle: nothing trains until `forge start` is typed on the
#                     console (`forge help` lists every command). Every env in the pool runs the current
#                     scenario. Each runs until its auto-started learner finishes (every class the run
#                     plays has converged on the generic signals, or it reaches total_env_steps, and it
#                     exits cleanly), then the next one starts; after the last one the sim idles again.
#                     There are no pass gates: nothing but a crash halts the plan, and a stage that ends
#                     at its budget says which classes were not done in runs/<scenario>/finished.json. A
#                     stage none of the run's classes can play (the stealth drill in a run without rogues
#                     or druids) is skipped. Moving on needs
#                     AnimusForge.Policy = "remote" and AnimusForge.Learner.AutoStart = 1 (see
#                     AnimusForge.Queue.LocalEpisodes for local policies). `forge start` rejects an unknown
#                     name and lists the available scenarios. Each scenario trains in
#                     <OutputDir>/runs/<scenario>/. Like any config key it can also be set from the
#                     environment: AC_ANIMUS_FORGE_QUEUE.
#        Values:      Curriculum: one policy for every class of AnimusForge.Classes, one scenario per
#                     stage. Every episode each learned seat is a new character: a random race the class
#                     allows, gender, level (1-80; 55-80 for death knights), a role the episode's makeup
#                     calls for and one of the class's specs that plays it, with its standard talent
#                     build and glyphs, the trainer spells of the level, gear from the item level band of
#                     the level with enchants and gems, and potions, bandages and stones it learns to
#                     use. Each class is a layout of the policy and exports as its own model, covering
#                     every role it can play: what the model is told is its role and its talents, never
#                     its spec, so it learns to play the character it was handed. Each stage's layouts
#                     extend the stage it builds on, which seeds it:
#                     The movement curriculum, rebuilt stage by stage on the player controller:
#                       movement  "move1_controls" (an empty Stockades: from the entrance to the end of the
#                                 hallway as fast as possible, stopped within a yard; every class and race at
#                                 level 1, death knights at 55)
#                                 "move2_seek" (the same Stockades: one real object in one of its 39
#                                 rooms, found by sight with no compass, and stopped beside)
#                                 "move3_interact" (an empty Deadmines, levels 17-20: the object the goal
#                                 names among decoys, a door opened by its lever, the cannon fired with
#                                 the gunpowder carried from the start; acting through the sight block)
#                                 "move4_follow" (an empty Ragefire Chasm or Deadmines: four followers keep
#                                 with a leader walking the dungeon's route; a death rises at the entrance)
#                     The combat stages (dungeon-curriculum C1-C3), from move3_interact, on a cleared Ragefire Chasm
#                     at its levels, the seat seeing what it fights:
#                       combat    "combat1_fight" (one creature at a time; a friend to taunt off and heal)
#                                 "combat2_packs" (packs of 2-4: casters, linked, fire; one pack at a time)
#                                 "combat3_survive" (packs that can kill: rest between them, come back after a
#                                 death from the entrance)
#                     The party stages (dungeon-curriculum G1-), from combat3_survive with move4_follow's party
#                     frames merged in (ten stages in all: group2_corridor and dungeon1_pulls were retired
#                     2026-10-08 with the route they stood on):
#                       party     "group1_roles" (a party of five on the cleared Ragefire Chasm drilling one role an
#                                 episode: hold every enemy, keep everyone up within mana, kill the tank's target
#                                 without pulling it, pull one pack at a time)
#                     The dungeon stages (dungeon-curriculum D2, D3), from group1_roles, real dungeons at their
#                     level bands:
#                       dungeon   "dungeon2_ragefire" (Ragefire from the door to Bazzalan, a full clear; Wailing
#                                 Caverns held out, evaluated only)
#                                 "dungeon3_deadmines" (the Deadmines from the door to VanCleef at 17-20, doors,
#                                 levers and the cannon by real presses; the bar: 70% clears, at most one wipe)
#                     Its first version (move1_controls ... move7_follow) was archived on 2026-10-05: definitions
#                     on the git tag curriculum-movement-v1.
#                     The first curriculum (stage1_move ... stage21_ship) was archived on 2026-10-05 -- its
#                     definitions on the git tag curriculum-v1 (both, with their configs, are on the tag
#                     pre-cleanup-2026-10-07). Stages that need their own env count set it with
#                     AnimusForge.Stage.<name>.Envs.
#        Example:     "move1_controls" - (train a single scenario)
#        Default:     "" - (the whole curriculum, first stage to last)

AnimusForge.Queue = ""

#
#    AnimusForge.Queue.SkipFinished
#        Description: `forge start` without scenarios leaves out queued scenarios whose run already
#                     finished and moved on (runs/<scenario>/finished.json in AnimusForge.OutputDir with
#                     "advanced": true), so it continues where training stopped instead of training
#                     every stage again. A cancelled stage trains again. Scenarios
#                     named on `forge start` always train. To retrain a finished stage, move its run
#                     directory away or set this to 0. Only with the remote policy.
#        Default:     1 - (Skip finished runs)
#                     0 - (Train every queued scenario, archiving earlier runs)

AnimusForge.Queue.SkipFinished = 1

#
#    AnimusForge.Queue.LocalEpisodes
#        Description: With a local AnimusForge.Policy ("random", a scripted baseline), run this many
#                     episodes (over all envs) per queued scenario, then move to the next. Use it to
#                     smoke-test or baseline every scenario in one server run.
#        Default:     0 - (a local policy runs the first queued scenario forever)

AnimusForge.Queue.LocalEpisodes = 0

#
#    AnimusForge.Classes
#        Description: Comma-separated classes the curriculum stages play (their layouts). A subset trains
#                     a policy for just those, e.g. "warrior, priest". Changing the list changes the
#                     layouts: models of the earlier list do not fit the new one.
#                     A class brings every role it can play with it -- there is one model per class, not
#                     one per class and role -- so listing "paladin" trains its healing, its tanking and
#                     its damage in one policy. Leaving out a class can leave a stage unable to fill a
#                     composition: a run of only rogues and mages has no tank to offer a party, and the
#                     seats fall back to whatever the run does have.
#                     Available: warrior, paladin, hunter, rogue, priest, deathknight, shaman, mage,
#                     warlock, druid
#        Default:     "" - (all of them)

AnimusForge.Classes = ""

###################################################################################################
# ENVIRONMENTS
#
#    AnimusForge.Envs
#        Description: Number of parallel environments. Each env gets its own instance map, so envs
#                     are spread across MapUpdate.Threads.
#        Default:     64

AnimusForge.Envs = 64

#
#    AnimusForge.ContinentReplicas
#        Description: How many copies of the continent a continent stage spreads its envs over. Each is a
#                     Map object of its own, so each is a map task of its own and the envs on it are
#                     scored and observed on its thread; without this a whole pool shares one continent
#                     and therefore one thread. An env stands in one of the 31 phases its map has, so a
#                     replica holds at most 31 envs and 0 asks for the fewest replicas that allows.
#                     Sizing, not a switch. A replica shares the continent's terrain, collision tree and
#                     navmesh with the base map and loads grids only where its envs stand, so it costs the
#                     creatures and gameobjects of those grids, not a copy of the continent. Instance
#                     stages ignore it -- every env already has an instance of its own.
#        Default:     0 - (31 envs per continent, which is one map up to 31 envs as before)

AnimusForge.ContinentReplicas = 0

#
#    AnimusForge.Stage.<name>.Envs
#        Description: a stage's own env count, where the default would not do. The real raids are forty seats an
#                     env, so a raid stage at 128 envs could be 5,120 bots; a stage like that sets its own
#                     count here (`AnimusForge.Stage.<name>.Envs = 16`). Any stage name works. None are set:
#                     the stages that set one (the raids) were archived with the first curriculum (git tag
#                     curriculum-v1).
#        Default:     AnimusForge.Envs

#
#    AnimusForge.DecisionMs
#        Description: Game time per agent decision, in milliseconds. Read once at startup (a change needs a
#                     restart). Per-decision reward terms are scaled to stay the same per second, and the
#                     learner's discounts are compounded to it, so this is the unit everything that costs
#                     game time is written in. Models play at this interval (mod-animus:
#                     Animus.ClassRole.DecisionMs and Animus.Stage.DecisionMs).
#                     250 ms is about a player's reaction time: a decision there has to count for something,
#                     where at 100 ms policies re-decided ten times a second and dithered.
#        Default:     250

AnimusForge.DecisionMs = 250

#
#    AnimusForge.TicksPerDecision
#        Description: World updates per decision. At 1 the sim's world tick is the decision -- the world
#                     advances AnimusForge.DecisionMs and the policy chooses, which is what the sim did
#                     before the two were separable. Above 1 the worldserver ticks at DecisionMs divided by
#                     this, and the module holds the decision back until that many ticks have passed: the
#                     world moves in finer steps while the policy still chooses every DecisionMs.
#                     What it buys is movement. A spline, a cast bar and a periodic aura all advance per
#                     world update, so at one tick per decision a bot's path is a 250 ms staircase and a
#                     dodge cannot be finer than that. Cutting the tick smooths all of it without making the
#                     policy decide more often, which is the expensive half.
#                     What it costs is world time: four ticks per decision runs the map update, the spline
#                     and the aura ticks four times as often, so throughput falls roughly with it. The
#                     learner is unaffected -- it is told the split and still sees one step per decision.
#                     DecisionMs must divide by it; a remainder is rounded down at startup with a warning,
#                     so a decision stays a whole number of ticks. Read once at startup, and the worldserver
#                     reads the same key, so a change needs a restart of both (./forge.sh --build).
#        Default:     1

AnimusForge.TicksPerDecision = 1

#
#    AnimusForge.Stage.<name>.TicksPerDecision
#        Description: One stage's own world updates per decision, where the default would not do: the movement
#                     stages want the finer world (smooth splines, the facing kept on a moving target between
#                     decisions, turns shown swung to a watching client) without every stage paying for it. The
#                     worldserver takes the stage's tick while it runs and the configured one again after, so
#                     no restart is needed. It must divide AnimusForge.DecisionMs; one that does not is dropped
#                     with an error. Under AnimusForge.HalfBatch such a stage runs as one group.
#                     The live curriculum sets none: M1 and M2 were trained at 1 tick per decision with
#                     AnimusForge.HalfBatch = 1 on every machine, and changing the tick between stages would
#                     change the timing a seeded policy has learned (decision 0006, update 2026-10-09). A
#                     machine that sets one for a stage runs it at DecisionMs / that many ticks (50 ms ticks
#                     are 5 at the default 250 ms decisions), and the pooled data must agree on every machine.
#        Default:     (none: every stage uses AnimusForge.TicksPerDecision)

#AnimusForge.Stage.move1_controls.TicksPerDecision = 5
#AnimusForge.Stage.move2_seek.TicksPerDecision = 5
#AnimusForge.Stage.move3_interact.TicksPerDecision = 5
#AnimusForge.Stage.move4_follow.TicksPerDecision = 5
# The combat stages move on the player controller too.
#AnimusForge.Stage.combat1_fight.TicksPerDecision = 5
#AnimusForge.Stage.combat2_packs.TicksPerDecision = 5
#AnimusForge.Stage.combat3_survive.TicksPerDecision = 5
# ... and the party stages.
#AnimusForge.Stage.group1_roles.TicksPerDecision = 5
#   ... and the dungeons (D2, D3), on the player controller too
#AnimusForge.Stage.dungeon2_ragefire.TicksPerDecision = 5
#AnimusForge.Stage.dungeon3_deadmines.TicksPerDecision = 5

#
#    AnimusForge.HalfBatch
#        Description: Split the envs into two halves whose maps tick in turn, so the learner decides one half
#                     while the other half's maps tick, instead of the sim and the learner taking turns.
#                     The world ticks at half a decision; each half's maps sit out every other world tick
#                     and then tick with the time of both, so every env still observes, acts and moves
#                     DecisionMs at a time exactly as without it. Needs TicksPerDecision = 1, and two
#                     halves on separate maps: a continent stage's AnimusForge.ContinentReplicas even and
#                     dividing the envs (otherwise it runs as one group and says so). Pays when the
#                     learner's update fits inside the faster rollout (see the forge-parallel-core plan).
#                     The live curriculum trains with it at 1 on every machine (decision 0006).
#                     Read once at startup by the module and the worldserver: a change needs a restart.
#        Default:     0

AnimusForge.HalfBatch = 0

#
#    AnimusForge.Decision.JitterMs
#        Description: Tick jitter: the body of the overshoot of a decision, in milliseconds. The realm decides on the
#                     first world tick that brings a bot's accumulated tick time to DecisionMs and keeps the
#                     remainder (mod-animus CompanionParty), and its ticks are variable (stock
#                     MinWorldUpdateTime 1, MapUpdateInterval 10), so a decision comes
#                         DecisionMs - (the last decision's overshoot) + (its own)
#                     after the one before: DecisionMs on average, a tick either side at worst. Training with
#                     exact ticks showed a model one cadence only. With this set, every decision of every stage is
#                     sized from an overshoot drawn from U(0, JitterMs), and the world advances that much game
#                     time -- movement, auras, cooldowns, regeneration and the episode clock all integrate the
#                     real step, and a per-second reward term is charged for the time that went by. The
#                     observation does not change: what ages in it (entity and map memory, the free look) ages
#                     by DecisionMs, which is all the realm's module knows. One draw per decision for the whole
#                     pool, because the game clock (cooldowns, the global cooldown) is one; with
#                     TicksPerDecision above 1 all the decision's ticks share the time. 0 with SpikeProb 0
#                     switches it off: every decision is exactly DecisionMs, as before. 50 is a stock world
#                     update; tune it from `python -m animus.human parity`'s realm timing once captured.
#                     Read at the start of every scenario; the learner is told (SPEC, protocol 27). The same on
#                     every machine of a cluster (the fingerprint refuses a worker that differs). Changing it
#                     under a run you resume shifts the step it was trained on: the learner is not told per
#                     step, so resume it deliberately.
#        Default:     50
#        Range:       0 - 1000

AnimusForge.Decision.JitterMs = 50

#
#    AnimusForge.Decision.SpikeProb
#        Description: A decision's chance of a load spike on top of the jitter's body: the realm's world tick
#                     now and then takes far longer (a save, a flush, another worker's load), and the
#                     decision that tick ends is late by all of it, and the next comes sooner (the carry). The spike adds U(50, SpikeMaxMs) ms to that
#                     decision's overshoot; a spike over DecisionMs makes one long decision and a short one
#                     after it, as the realm does. 0 = none.
#        Default:     0.02
#        Range:       0 - 1

AnimusForge.Decision.SpikeProb = 0.02

#
#    AnimusForge.Decision.SpikeMaxMs
#        Description: The largest spike, in milliseconds (see SpikeProb). A value of 50 or less is no spike.
#                     At the defaults the longest decisions run to about 650-700 ms and the shortest to a few ms
#                     (the one after a spike).
#        Default:     400
#        Range:       0 - 5000

AnimusForge.Decision.SpikeMaxMs = 400

#
#    AnimusForge.Decision.Seed
#        Description: This machine's stream of the jitter. The stream is a hash of (Seed, the scenario's name, the
#                     cluster advertise address, the decision number), never the world's random numbers
#                     (an evaluation episode reseeds those), so a run on one machine repeats and the machines
#                     of a cluster draw different streams of the same distribution. Not compared across
#                     a cluster.
#        Default:     1

AnimusForge.Decision.Seed = 1

#
#    AnimusForge.EpisodeSeconds
#        Description: Game-time length of an episode, in seconds. Episodes end by truncation.
#        Default:     60

AnimusForge.EpisodeSeconds = 60

#
#    AnimusForge.SpawnPoint.MapId
#    AnimusForge.SpawnPoint.X / Y / Z / O
#        Description: Instanceable (dungeon) map and position where each env's bots start. The map
#                     must have an instance_template row. The default is the Old Hillsbrad Foothills
#                     entrance: its nearest creature spawn is 352 yd away, well outside visibility.
#        Default:     560, 2741.9, 1315.2, 14.0, 2.96

AnimusForge.SpawnPoint.MapId = 560
AnimusForge.SpawnPoint.X     = 2741.9
AnimusForge.SpawnPoint.Y     = 1315.2
AnimusForge.SpawnPoint.Z     = 14.0
AnimusForge.SpawnPoint.O     = 2.96

###################################################################################################
# POLICY
#
#    AnimusForge.Policy
#        Description: Who chooses actions.
#        Values:      "remote"          - lock-step with the Python learner over AnimusForge.Socket
#                     "random"          - uniform over unmasked actions
#        Default:     "remote"

AnimusForge.Policy = "remote"

#
#    AnimusForge.ReportEpisodes
#        Description: Mean episode statistics are taken over this many completed episodes (all
#                     policies, including remote). They show in `forge status` and in the progress report
#                     of local policy runs, and in the log at debug level.
#        Default:     256

AnimusForge.ReportEpisodes = 256

#
#    AnimusForge.Socket
#        Description: Unix domain socket path the remote policy listens on, relative to the directory of
#                     worldserver.conf or absolute.
#        Default:     "/tmp/animus-forge.sock"

AnimusForge.Socket = "/tmp/animus-forge.sock"

###################################################################################################
# EPISODE RESETS
#
#    AnimusForge.ResetOnMapThreads
#        Description: Rebuild each ended episode on the thread that updates its map, right after that
#                     map's tick, instead of on the world thread after every map has finished. Only for
#                     stages whose episodes stay on their own continent replica and build nothing every
#                     map shares (no instances, battlegrounds, quests, gathering, towns, owners, parties
#                     or director); the rest reset on the world thread as before. What a reset must do on
#                     the world thread (logging old characters out, the character cache, the social and
#                     instance-bind managers) still does, right after the maps join.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, every reset on the world thread)

AnimusForge.ResetOnMapThreads = 1

###################################################################################################
# CAMERA VISION
#
#    The vision block's third-person camera (camera-vision): the seat turns it itself (free look: a
#    yaw rate, a pitch rate and a zoom step chosen every decision; it never adjusts itself, and the
#    seat recentres it or turns to it), rendered every decision by ray casts against the loaded
#    terrain, collision trees and liquids.
#    A value outside its range is clamped into it and logged. `forge camera snapshot` renders one
#    frame with these settings.
#
#    AnimusForge.Vision.Width
#        Description: Image columns of the vision block's camera (stages with a vision block,
#                     move1_controls): the canonical image, the one the learner's network reads.
#                     Width and Height decide the image each agent sends, Width x Height x 4
#                     bytes beside its observation (the block's own columns are 11 scalars): a
#                     model trained at one size does not fit another. Frames are cast at the
#                     smaller RenderSizes and scaled up to it. The learner cuts it into a grid of
#                     16 patches across (8 x 8 pixels at the default), so Width is a multiple of
#                     16 and Height of Width / 16.
#        Default:     128 - (8 to 256)

AnimusForge.Vision.Width = 128

#
#    AnimusForge.Vision.Height
#        Description: Image rows of the camera's canonical image.
#        Default:     64 - (8 to 256)

AnimusForge.Vision.Height = 64

#
#    AnimusForge.Vision.RenderSizes
#        Description: The sizes frames are actually cast at, "WxH" or "WxH:weight" separated by
#                     commas, each at most Width x Height: the same field of view with fewer,
#                     wider rays, scaled up into the canonical image by nearest pixel. Each seat
#                     draws one at every episode reset, by weight (above 0; 1 when not given), so
#                     the model learns to see at all of them; with one entry every seat renders
#                     at it (pick the tier a machine can afford). The default renders about one
#                     episode in eight natively at 128 x 64 (0.4 of 3.4), what a renderer at the
#                     canonical size gives. An entry that does not parse or does not fit is left
#                     out and logged; none left renders at Width x Height.
#        Default:     "32x16, 48x24, 64x32, 128x64:0.4"

AnimusForge.Vision.RenderSizes = "32x16, 48x24, 64x32, 128x64:0.4"

#
#    AnimusForge.Vision.FovH
#        Description: Horizontal field of view, degrees. Pixels are square when FovH / Width equals
#                     FovV / Height (0.9375 degrees at the defaults).
#        Default:     120 - (30 to 170)

AnimusForge.Vision.FovH = 120

#
#    AnimusForge.Vision.FovV
#        Description: Vertical field of view, degrees.
#        Default:     60 - (20 to 120)

AnimusForge.Vision.FovV = 60

#
#    AnimusForge.Vision.Range
#        Description: Yards around the camera within which units are seen. Rays themselves have
#                     no range: a ray ends at what it hits, or reads as sky once it leaves the
#                     loaded grids; the distance channel is log-scaled to 1000 yd.
#        Default:     100 - (10 to 500)

AnimusForge.Vision.Range = 100

#
#    AnimusForge.Vision.Zoom
#        Description: Yards from the pivot (the head) back to the camera, before the boom pulls in
#                     at a wall. 0 sees from the eyes. A seat's camera starts each episode at the
#                     zoom level nearest it (0, 3, 6 or 12 yd) and steps between those levels.
#        Default:     6 - (0 to 50)

AnimusForge.Vision.Zoom = 6

#
#    AnimusForge.Vision.Pitch
#        Description: The camera's pitch, degrees, + up: the default looks slightly down. A seat's
#                     camera starts each episode here and returns here when it recentres.
#        Default:     -15 - (-80 to 80)

AnimusForge.Vision.Pitch = -15

#
#    AnimusForge.Vision.AuditInterval
#        Description: Every this many seconds of real time while a stage with a camera trains or
#                     runs, save AuditSeats seats' frames, exactly as the learner gets them, to
#                     runs/<scenario>/camera/: one PNG a frame (depth, kind, height over the feet
#                     and slope, side by side; the objective white) and a row in audit.csv (who,
#                     where, when, pixels of each kind). The seats are drawn at random, one a
#                     layout first. 0 saves none.
#        Default:     300 - (0 to 86400)

AnimusForge.Vision.AuditInterval = 300

#
#    AnimusForge.Vision.AuditSeats
#        Description: Frames saved at each audit.
#        Default:     4 - (1 to 64)

AnimusForge.Vision.AuditSeats = 4

#
#    AnimusForge.Vision.EvalVideos
#        Description: Episodes of every evaluation filmed as the seat saw them, for watching later:
#                     one frame a decision (the composite picture, with the mini-map inset where
#                     the stage has a map), written as an animated PNG (a browser plays it) with a
#                     JSON sidecar (class, race, layout, seed, rung, outcome, the episode's
#                     measures) to runs/<scenario>/videos/<env steps>/<seed>-<class>-<outcome>.png,
#                     and an index.json and index.html per evaluation. The episodes are chosen from
#                     the evaluation's seeds alone, spread over the classes and rungs, so every
#                     checkpoint films the same ones. A cluster's sims each film this many of
#                     their own share. 0 films none.
#        Default:     8 - (0 to 64)

AnimusForge.Vision.EvalVideos = 8

#
#    AnimusForge.Vision.EvalVideoScale
#        Description: Each camera pixel drawn this many times as wide and high in the videos
#                     (nearest pixel): 4 makes a 128 x 64 camera 512 x 256.
#        Default:     4 - (1 to 8)

AnimusForge.Vision.EvalVideoScale = 4

#
#    AnimusForge.Map.MaxTiles
#        Description: The mental map (a stage with a map block, perception-goals REDESIGN §3):
#                     the most 32 x 32-yard tiles a seat's map keeps, the least recently written
#                     going first. Training's 4096 is about 4 km2; the Stockades is about 60. A
#                     realm's companion would keep 256 (with CoarseTiles).
#        Default:     4096 - (1 to 65536)

AnimusForge.Map.MaxTiles = 4096

#
#    AnimusForge.Map.CoarseTiles
#        Description: Coarse tiles (8-yard cells, 256 yards a tile) an evicted fine tile is folded
#                     into rather than forgotten, read where no fine tile is kept. 0 forgets it
#                     (training).
#        Default:     0 - (0 to 65536)

AnimusForge.Map.CoarseTiles = 0

#
#    AnimusForge.Map.KeepShare
#        Description: The share of a training seat's resets on the same instance that keep its
#                     map (stale memory, as a shipped bot has); the others start it empty. An
#                     evaluation always starts it empty.
#        Default:     0.5 - (0 to 1)

AnimusForge.Map.KeepShare = 0.5

#
#    AnimusForge.Map.AgeOffsetSeconds
#        Description: A kept map is this much older at most, drawn uniformly from 0 at each reset
#                     that keeps it: every look and entity in it ages by the draw.
#        Default:     600 - (0 to 36000)

AnimusForge.Map.AgeOffsetSeconds = 600

#
#    AnimusForge.Memory.MaxEntities
#        Description: Entity memory (a stage with a sight block, dungeon-curriculum I2): the most
#                     entities a seat remembers -- what each was, where and how it was last seen --
#                     the least recently seen going first. Training's is 64; a realm may keep more.
#                     Kept across resets with the map (AnimusForge.Map.KeepShare, AgeOffsetSeconds).
#        Default:     64 - (1 to 1024)

AnimusForge.Memory.MaxEntities = 64

###################################################################################################
# LEARNER
#
#    AnimusForge.Learner.AutoStart
#        Description: With AnimusForge.Policy = "remote", start the Python learner automatically
#                     whenever a scenario of `forge start` or `forge resume` is ready:
#                         <Python> -u -m animus.train --config <Config> --socket <AnimusForge.Socket>
#                             --run-name <scenario> --runs-dir <OutputDir>/runs --layouts-dir <OutputDir>/layouts
#                     run in <WorkDir>. `forge start` trains from scratch: whatever runs/<scenario>/ held is
#                     moved to runs/_archive/<scenario>-<time>/ first (nothing is deleted). `forge resume`
#                     adds --resume and continues runs/<scenario>/latest.pt instead. The learner is
#                     stopped (and saves latest.pt) by `forge cancel`, `forge skip` and server shutdown.
#                     Requires Python and the learner's packages where the worldserver runs, and the
#                     module source tree: a native build, or the Docker ac-worldserver service, which
#                     runs the build from the bind-mounted source tree.
#        Default:     1 - (Enabled)
#                     0 - (Disabled, start the learner yourself)

AnimusForge.Learner.AutoStart = 1

#
#    AnimusForge.Learner.WorkDir
#        Description: Directory the learner runs in (the module's python/ directory). Relative to the
#                     directory of worldserver.conf, or absolute.
#        Default:     "" - the python/ directory of the module source this server was built from

AnimusForge.Learner.WorkDir = ""

#
#    AnimusForge.Learner.Python
#        Description: Python interpreter for the learner: a name found on PATH, or a path (relative to the
#                     directory of worldserver.conf, or absolute).
#        Default:     "" - <WorkDir>/.venv/bin/python if it exists, otherwise python3 from PATH

AnimusForge.Learner.Python = ""

#
#    AnimusForge.Learner.Config
#        Description: Learner config for every scenario, relative to the directory of worldserver.conf or
#                     absolute. The run is
#                     always named after the scenario (--run-name).
#                     Left empty, a run of a single AnimusForge.Classes uses that class's own
#                     configs/<class>/<scenario>.yaml where one exists, and the shared
#                     configs/<scenario>.yaml otherwise. A curriculum trained one class at a time wants
#                     per-class floors -- a restoration druid and a bear are not held to the same clean
#                     kill rate -- and a single overlay file cannot express them, because an overlay
#                     merges section by section and would hand every stage in the queue the same
#                     `target` when stage one gates `arrived` and stage five gates `clean_kill`.
#        Default:     "" - configs/<class>/<scenario>.yaml if it exists, else configs/<scenario>.yaml

AnimusForge.Learner.Config = ""

#
#    AnimusForge.Learner.Args
#        Description: Extra learner arguments appended to every learner command line, split on spaces
#                     (no quoting). Mostly "--set key=value" to override learner config values for the
#                     whole queue without editing the YAML files, e.g. a short pass over a curriculum.
#        Example:     "--set total_env_steps=5000000 --set eval.every_env_steps=1000000"
#        Default:     ""

AnimusForge.Learner.Args = ""

#
#    AnimusForge.Learner.TorchThreads
#        Description: CPU threads the learner's torch may use (--set torch_threads). The learner and the
#                     sim's map update threads (MapUpdate.Threads in worldserver.conf) share the machine,
#                     so leaving torch every core can be slower overall. `forge bench` measures both.
#        Default:     0 - (torch's own default: a thread per core)

AnimusForge.Learner.TorchThreads = 0

#
#    AnimusForge.Learner.TrainDevice
#    AnimusForge.Learner.RolloutDevice
#        Description: Where the learner updates its networks (TrainDevice) and where it runs the
#                     envs' action inference (RolloutDevice): "cuda:0", "cuda:1", "cpu" ("cuda"
#                     means the ROCm or CUDA device alike). "auto" leaves it to the GPU mode:
#                     each learner on its own GPU (the largest ones counted), or the stage
#                     config's train_device / rollout_device when no GPU was counted. With
#                     several learners (multi mode) a GPU named here is the first learner's and
#                     learner k takes the k-th after it; "cpu" is every learner's. A GPU the
#                     machine does not have yet falls back to the first one (or the CPU) with a
#                     line in the learner log, so this can be set ahead of the card.
#                     AnimusForge.Learner.Args still override both.
#        Default:     "auto"

AnimusForge.Learner.TrainDevice = "auto"
AnimusForge.Learner.RolloutDevice = "auto"

#
#    AnimusForge.Learner.Cpus
#        Description: The CPUs the learner runs on, as a list like "8-15,24-31"; several learners
#                     (multi mode) share them out by whole physical cores. "auto" gives it every
#                     core the map update (MapUpdate.Cpus) does not use. `forge status` shows
#                     both placements.
#        Default:     "auto"

AnimusForge.Learner.Cpus = "auto"

###################################################################################################
# GPU MODE
#
#    Single-GPU and multi-GPU operation, each with its own settings. In multi mode the
#    worldserver starts one learner per GPU: each takes an equal share of the envs, collects
#    rollouts on its own GPU, and their gradients are averaged every step (NCCL / RCCL), so N
#    GPUs update on N times the envs in about the time one takes on its share. Learner k runs
#    on the k-th GPU, on its own slice of the cores the map update leaves free, and logs to
#    animus-learner.rank<k>.log; learner 0 writes the run. A cluster worker runs no learner.
#    `forge status` and the startup log say which mode is in force and why.
#
#    AnimusForge.Gpu.Observe
#        Description: Load the forge's device library (libforge-gpu.so, beside the worldserver, built
#                     where hipcc is) on the learner's own HIP runtime, so observations can be written
#                     straight into GPU memory the learner reads. Without a GPU, a torch with HIP or
#                     the library, the forge says why once and does everything on the CPU.
#                     Off by default: with the learner's updates running whole (it once recorded
#                     each decision's inputs too late and cut its updates short), the host transport
#                     measured faster -- 39,181 against 36,657 env steps/s on stage4_duel, 30,489
#                     against 28,777 on stage1_move -- because the sim's copies into device memory
#                     cost it more than the learner's upload saved. It becomes the default again
#                     when the observations are produced on the GPU rather than copied there.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AnimusForge.Gpu.Observe = 0

#
#    AnimusForge.ObserveAfterJoin
#        Description: Hold each map's observation back until every map task of the update has
#                     joined, then run them as map work again: the barrier a device kernel over every
#                     seat would need. A measurement switch: on stage4_duel it cost about 0.07 ms a
#                     map update (43,162 against 42,977 env steps/s).
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AnimusForge.ObserveAfterJoin = 0

#
#    AnimusForge.Gpu.Mode
#        Description: auto: count the GPUs the learner's torch sees (ROCm or CUDA) with at least
#                     half the compute units of the largest -- an integrated GPU beside a card
#                     does not count -- and run multi mode with two or more, single mode
#                     otherwise. Counted once per worldserver start. single / multi force it
#                     (multi on one GPU: the learners share it; correct, not faster).
#        Default:     "auto"

AnimusForge.Gpu.Mode = "auto"

#
#    AnimusForge.Gpu.Single.Envs
#    AnimusForge.Gpu.Multi.Envs
#        Description: Envs in that mode, in place of AnimusForge.Envs. 0: single mode uses
#                     AnimusForge.Envs; multi mode uses AnimusForge.Envs (and each
#                     AnimusForge.Stage.<name>.Envs) times the learners, so every GPU gets the
#                     batch one GPU would. Fast runs keep AnimusForge.Fast.Envs.
#        Default:     0

AnimusForge.Gpu.Single.Envs = 0
AnimusForge.Gpu.Multi.Envs = 0

#
#    AnimusForge.Gpu.Single.Minibatches
#    AnimusForge.Gpu.Multi.Minibatches
#        Description: mappo.minibatches in that mode (0 = the stage config's). Per learner: in
#                     multi mode each cuts its own rollout into this many and their gradients
#                     are averaged, so a step's batch is learners x as large. Scaling it with
#                     the learners keeps one GPU's batch per step, but each learner's update
#                     then takes as many sequential steps as the scale, which costs most of
#                     what the extra GPUs bought: leave 0 unless training asks for it.
#        Default:     0

AnimusForge.Gpu.Single.Minibatches = 0
AnimusForge.Gpu.Multi.Minibatches = 0

#
#    AnimusForge.Gpu.Single.LearnerArgs
#    AnimusForge.Gpu.Multi.LearnerArgs
#        Description: Extra learner arguments in that mode, after AnimusForge.Learner.Args (so a
#                     --set here wins), e.g. "--set mappo.lr=0.0005".
#        Default:     ""

AnimusForge.Gpu.Single.LearnerArgs = ""
AnimusForge.Gpu.Multi.LearnerArgs = ""

#
#    AnimusForge.Gpu.Multi.Learners
#        Description: Learners in multi mode (1-16). 0: one per GPU counted.
#        Default:     0

AnimusForge.Gpu.Multi.Learners = 0

###################################################################################################
# CLUSTER
#
#    Several machines training one learner: the host runs its sim and the learner, each worker
#    runs only a sim, and the host's learner trains on every sim's envs as one pool. The host
#    orders its workers onto each scenario it starts; the data (STEP/ACT) goes straight between
#    the host's learner and each worker's sim over TCP. Every machine needs the same build, world
#    data and scenario settings; each may run its own number of envs (AnimusForge.Envs).
#
#    AnimusForge.Cluster.Role
#        Description: standalone (one machine, as always), host or worker.
#        Default:     "standalone"

AnimusForge.Cluster.Role = "standalone"

#
#    AnimusForge.Cluster.Host
#        Description: Worker: the host's control address, "address:port" (its ControlPort).
#        Default:     ""

AnimusForge.Cluster.Host = ""

#
#    AnimusForge.Cluster.ControlPort
#        Description: Host: the TCP port workers register on and take orders from.
#        Default:     7700

AnimusForge.Cluster.ControlPort = 7700

#
#    AnimusForge.Cluster.DataPort
#        Description: Worker: the TCP port its sim listens on for the host's learner.
#        Default:     7701

AnimusForge.Cluster.DataPort = 7701

#
#    AnimusForge.Cluster.Advertise
#        Description: Worker: the address the host's learner should reach it at, when the address
#                     its registration comes from is not it (NAT, several interfaces). Empty = that one.
#        Default:     ""

AnimusForge.Cluster.Advertise = ""

#
#    AnimusForge.Cluster.Learner
#        Description: Worker: run a learner of its own on this machine's GPU, training on this sim as one
#                     rank of the host's run: the host gives it a rank when it starts a scenario, and every
#                     learner's networks are averaged once an update (mappo.rank_sync = weights; syncing
#                     gradients every step is ~8 Gbit/s a link). Observations never cross the network. A
#                     learner that fails stops the others (after Learner's dist_timeout at the most) and the
#                     host restarts them all from the latest checkpoint, up to three times a scenario.
#                     "auto": when the learner's torch sees a GPU here. 0: the host's learner trains on this
#                     sim over the network instead, as before.
#        Default:     "auto"

AnimusForge.Cluster.Learner = "auto"

#
#    AnimusForge.Cluster.DistPort
#        Description: Host: the TCP port every machine's learners meet on (torch.distributed). Cluster
#                     machines run on the host's network (docker-compose.cluster.yml), so the learners'
#                     own connections between machines are reachable too.
#        Default:     7702

AnimusForge.Cluster.DistPort = 7702

#
#    AnimusForge.Cluster.Sync
#        Description: Host: how the machines' learners (AnimusForge.Cluster.Learner) share what they
#                     learn. async: each trains at its own pace on its own sim and trades its networks
#                     with the host's learner in the background (animus.async_sync); the host's
#                     learner evaluates and decides for all of them, and a slow machine costs the others
#                     nothing. weights: every learner's networks averaged once an update, in lockstep --
#                     every machine waits for the slowest at every update (measured on stage4_duel:
#                     7,885 env steps/s for three machines against 42,824 for the host alone).
#        Default:     "async"
#                     "weights"

AnimusForge.Cluster.Sync = "async"

#
#    AnimusForge.Learner.LogFile
#        Description: File the learner's stdout and stderr are appended to, relative to the directory of
#                     worldserver.conf or absolute.
#        Default:     "" - animus-learner.log in LogsDir

AnimusForge.Learner.LogFile = ""

###################################################################################################
# BENCHMARK
#
#    `forge bench [scenario]` measures how fast the sim runs at every MapUpdate.Threads x AnimusForge.Envs
#    pair below, then runs the fastest few again with the real learner, and reports the env steps per second
#    of each. It writes bench.json in <OutputDir>/bench and trains nothing: every trial runs in that
#    directory, so runs/ is untouched. `forge bench apply` writes the winner into worldserver.conf and this
#    file (the thread count takes effect on the next restart, the env count at the next `forge start`).
#
#    `forge status` shows the same measurement while training: env steps/s and where a decision's wall time
#    goes -- the world tick (the map update), this module (observing and acting) and waiting on the learner.
#
#    Note: more envs is not only speed. One learner update is rollout_length x envs x seats env steps, so
#    changing the env count changes the batch the learner trains on.
#
#    AnimusForge.Bench.Scenario
#        Description: Scenario the trials run, when `forge bench` is given none. A party stage (four seats
#                     per env) costs more per env than a solo one.
#        Default:     "" - (none: `forge bench` then needs a scenario named; the first curriculum's
#                     stage4_duel was the default until it was archived, git tag curriculum-v1)

AnimusForge.Bench.Scenario = ""

#
#    AnimusForge.Bench.Policy
#        Description: Local policy the sim-only trials play ("random", the only one: there are no scripted
#                     policies). The learner's own round trip is timed afterwards by the fastest trials.
#        Default:     "random"

AnimusForge.Bench.Policy = "random"

#
#    AnimusForge.Bench.Threads
#        Description: MapUpdate.Threads values to try, comma-separated. The sim switches the map update
#                     pool between trials, so no restart is needed while benchmarking. Every trial rebuilds
#                     the env pool, so a trial costs its warm-up and measured decisions plus that build:
#                     keep the grid to the counts worth telling apart. More threads than the machine has
#                     cores, once the learner's own threads are counted, only adds trials.
#                     "auto" works them out from the machine: a half, three quarters and all of its
#                     physical cores (in the process's cpuset), less the world thread, and on a cluster
#                     worker, whose learner runs elsewhere, into the SMT siblings too. The startup log
#                     says what it chose.
#        Default:     "auto"

AnimusForge.Bench.Threads = "auto"

#
#    AnimusForge.Bench.Envs
#        Description: AnimusForge.Envs values to try, comma-separated. Big env counts cost the most to
#                     build and to hold, so try the few that could win rather than a wide ladder.
#                     "auto": 6, 9, 12 and 16 envs a physical core, each a whole number of envs per
#                     continent replica (AnimusForge.ContinentReplicas), up to Bench.MaxEnvs.
#        Default:     "auto"

AnimusForge.Bench.Envs = "auto"

#
#    AnimusForge.Bench.MaxEnvs
#        Description: Never try more envs than this, whatever AnimusForge.Bench.Envs says.
#        Default:     512

AnimusForge.Bench.MaxEnvs = 512

#
#    AnimusForge.Bench.WarmupTicks
#        Description: Decisions a sim-only trial runs before it is timed, so the first episode (which every
#                     env starts together) and the cold caches are behind it.
#        Default:     128

AnimusForge.Bench.WarmupTicks = 128

#
#    AnimusForge.Bench.MeasureTicks
#        Description: Decisions timed per sim-only trial. What the window has to average over is episode
#                     ends: an env rebuilds its character there, and that rebuild is part of what training
#                     costs. Episodes end on the kill well before the 60 s limit, so at 64 envs a few
#                     hundred decisions already cover a hundred or so of them and the rate settles to a few
#                     percent. Raise it if trials of the same settings disagree by more than that.
#        Default:     384

AnimusForge.Bench.MeasureTicks = 384

#
#    AnimusForge.Bench.MaxMemoryPercent
#        Description: Once the machine's memory is this used after a trial, the bigger env counts of that
#                     thread count are skipped instead of being built.
#        Default:     80

AnimusForge.Bench.MaxMemoryPercent = 80

#
#    AnimusForge.Bench.LearnerTop
#        Description: How many of the fastest sim trials run again with the real learner, which is what
#                     training actually costs. Each one starts a learner of its own, so this is the
#                     expensive phase; two is enough to tell the top settings apart. 0 = sim only.
#        Default:     2

AnimusForge.Bench.LearnerTop = 2

#
#    AnimusForge.Bench.LearnerWarmupTicks
#        Description: The learner phase's own warm-up, which also has to cover the learner starting up and
#                     its first updates (one update per rollout_length decisions, 128 by default).
#        Default:     384

AnimusForge.Bench.LearnerWarmupTicks = 384

#
#    AnimusForge.Bench.LearnerMeasureTicks
#        Description: Decisions timed per learner trial. Longer than the sim-only window because the cost
#                     being measured now includes updates, which land once per rollout: this averages over
#                     several of them.
#        Default:     768

AnimusForge.Bench.LearnerMeasureTicks = 768

#
#    AnimusForge.Bench.LearnerTorchThreads
#        Description: AnimusForge.Learner.TorchThreads values to try in the learner trials, comma-separated
#                     (0 = torch's own default). Every value is tried with every setting of LearnerTop.
#        Default:     "0, 8"

AnimusForge.Bench.LearnerTorchThreads = "0, 8"

#
#    AnimusForge.Bench.AutoTune
#        Description: On a machine with no benchmark of its own CPU in the bench output directory (a
#                     fresh copy of the project, or a copy from another machine), run `forge bench auto`
#                     when the worldserver starts: the benchmark above, then its winner written into the
#                     configs and used at once. A cluster worker joins its host only once it is done, so
#                     it is never ordered onto a scenario while it measures. A cluster worker is tuned on
#                     its sim alone (its learner is the host's). It takes as long as the grid: tens of
#                     minutes. Off, `forge bench auto` does the same by hand.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

AnimusForge.Bench.AutoTune = 0

###################################################################################################
# FAST TEST RUN
#
#    `forge fast [scenario ...]` trains stages (default: every curriculum stage) on an easier
#    problem, to see quickly that training works and learns before a long run: fewer envs, a few
#    classes at one level, and learner settings that end each stage as soon as its evaluation
#    score stops improving. It always uses the remote policy and trains from scratch, in its own
#    output directory, so it never archives, seeds from or overwrites a real run. Every other
#    setting (decision interval, episode length, rewards) is the one above.
#
#    AnimusForge.Fast.Queue
#        Description: Comma-separated scenarios `forge fast` trains when given none, in order, each again
#                     from scratch (nothing is skipped because an earlier fast run of it finished).
#        Default:     ""  - (every curriculum stage in order, the raid stages included: a full run)
#                     "<stage>, <stage that extends it>" - (a stage from scratch and one seeded from it)

AnimusForge.Fast.Queue = ""

#
#    AnimusForge.Fast.Envs
#        Description: Parallel envs of a fast run.
#        Default:     32
#
#    AnimusForge.Fast.Budget
#        Description: Env steps each stage of a fast run trains for before the next one starts. A fast run
#                     is a fixed-budget sweep of the whole curriculum, not a smoke test: it plays the same
#                     content at every class and every level, and only the budget and the env count are
#                     smaller. Convergence is off for these runs, so a stage trains every step it was given
#                     rather than stopping as soon as its score flattens.
#
#                     Override per invocation: `forge fast 30M`, `forge fast 30M <stage>`. A suffix of K
#                     or M is understood, and a bare number under 1000 is read as a scenario name rather
#                     than a budget.
#
#                     At the default this is a day or more over the whole queue; `forge status` reports the
#                     total so it is not started by accident.
#        Default:     20000000

AnimusForge.Fast.Envs = 32
AnimusForge.Fast.Budget = 20000000

#
#    AnimusForge.Fast.OutputDir
#        Description: Where a fast run's runs/, layouts/ and exported models/ go; relative to
#                     AnimusForge.OutputDir. `forge clean fast` deletes it.
#        Default:     "fast"

AnimusForge.Fast.OutputDir = "fast"

#
#    AnimusForge.Fast.Learner.Overlay
#        Description: Learner config merged over every stage's config in a fast run (--overlay),
#                     relative to the directory of worldserver.conf or absolute. The default evaluates
#                     often and trains every stage its whole budget (the sim sets patience to 0).
#        Default:     "" - configs/fast.yaml

AnimusForge.Fast.Learner.Overlay = ""

#
#    AnimusForge.Fast.Learner.Args
#        Description: Extra learner arguments for fast runs only, after AnimusForge.Learner.Args.
#        Example:     "--set convergence.window=2" - (a shorter convergence window for a rehearsal)
#        Default:     ""

AnimusForge.Fast.Learner.Args = ""

###################################################################################################
# CONSOLE
#
#    AnimusForge.ModelDir
#        Description: Folder `forge export` writes .amdl models (and their layout manifests) to, relative
#                     to the directory of worldserver.conf or absolute. Models are never copied anywhere else: copy
#                     them to a game server by hand. `forge clean exports` empties it.
#        Default:     "" - models/ in the module source this server was built from

AnimusForge.ModelDir = ""

#
#    AnimusForge.DataDir
#        Description: Folder for the data Animus generates or ships, relative to the directory of
#                     worldserver.conf or absolute. The baked camera scenes live in its scenes/ subfolder, one
#                     <map id>.scene file per map a stage runs on. The worldserver bakes a scene itself at
#                     startup when its file is missing or was baked from other map data, so the folder must be
#                     writable and should be persisted (a fresh one only costs the bake again; with the stock
#                     maps a few seconds a map). Every machine of a cluster bakes into its own copy; the
#                     cluster fingerprint refuses a worker whose scenes differ from the host's. The folder may
#                     differ per machine.
#        Default:     "" - modules/animus in the directory of worldserver.conf (the folder a realm's module
#                     installs its models into)

AnimusForge.DataDir = ""

#
#    AnimusForge.Progress.Interval
#        Description: While a scenario runs, also log the progress report every this many wall-clock
#                     seconds: env steps, step rate, ETAs (step limit, earliest convergence, the whole
#                     plan), evaluation scores against the baseline, restarts, losses and warnings
#                     (stalled learner, falling step rate, entropy collapse, large updates, non-finite
#                     values, convergence close). The report is always printed when a stage ends, and
#                     `forge status` prints it at any time; `forge progress <seconds|off>` changes the
#                     interval until the server restarts.
#        Default:     0  - (no periodic report)

AnimusForge.Progress.Interval = 0

###################################################################################################
# CURRICULUM TUNING
#
# What the curriculum trains on and what it is paid for: the characters, parties, pulls
# and scripted players it meets, and the reward weights. Every key is optional; a missing one keeps
# the default shown. The effective values are written to <OutputDir>/layouts/<stage>/stage.json and
# copied into every run directory. Per-decision reward terms are tuned per 50 ms decision and scaled
# with AnimusForge.DecisionMs.

#
#    AnimusForge.Curriculum.Arena.<stage>.<arena>.Weight
#        Description: A stage's share of episodes for one of its arenas (see stage.json "arenas"), e.g.
#                     AnimusForge.Curriculum.Arena.<stage>.chain.Weight = 2 for twice the chain arena's
#                     default share. Only matters for stages with several arenas.
#        Default:     the stage definition's weight (1 for every arena of the current stages)

#
#    AnimusForge.Curriculum.Arena.<stage>.<arena>.WeightFinal
#        Description: An arena's share of episodes at the end of the stage's budget, reached linearly from
#                     Weight as training goes (the learner's progress): an arena weighted up as the skills it
#                     needs come in. Evaluation draws by the final weights. A value below 0 is taken as 0;
#                     when every arena's final weight is 0 the final weights are the Weight values.
#        Default:     the stage definition's WeightFinal, else the arena's Weight

#
#    AnimusForge.Curriculum.Characters.*
#        The seat characters.

#   levels at or above this are "high"
AnimusForge.Curriculum.Characters.HighLevelFirst = 61
#   percent of characters drawn from the high levels
AnimusForge.Curriculum.Characters.HighLevelChance = 50
#   levels at or below this are "low"
AnimusForge.Curriculum.Characters.LowLevelLast = 20
#   percent of characters drawn from the low levels (when the class can be that low); the rest are any level
AnimusForge.Curriculum.Characters.LowLevelChance = 15
#   percent of characters: the standard build with its last points moved (0 = never)
AnimusForge.Curriculum.Characters.NoisyTalentChance = 30
#   percent of characters: every talent point spent at random (the rest get the spec's standard build)
AnimusForge.Curriculum.Characters.RandomTalentChance = 10
#   a noisy build moves 1 to this many of its last points
AnimusForge.Curriculum.Characters.TalentNoisePoints = 5
#   percent of pet-class characters (hunters, warlocks, death knights with Master of Ghouls, frost mages with Glyph
#   of Eternal Water) that start with their pet out, as a player arrives with one
AnimusForge.Curriculum.Characters.PetOutChance = 50
#   episodes a seat keeps its character for when the next episode draws the same class and build, before it is
#   built afresh (race, level, talents, gear). A kept character is healed, cleared of buffs and cooldowns, restocked
#   and moved to the new spawn, at a fraction of a build's cost; the level stays what it was. Evaluations always
#   build. 0 = build every episode. `forge status` counts the characters reused per decision beside the rebuilt.
AnimusForge.Curriculum.Characters.ReuseEpisodes = 4
#   1: in training a seat whose character can still be kept (ReuseEpisodes) keeps its class and build too, where
#   no party makeup is drawn, instead of keeping the character only when the draw happens to repeat. Each env's
#   classes then come in runs of up to ReuseEpisodes episodes; the mix across envs is the draw's. 0 = draw every
#   episode.
AnimusForge.Curriculum.Characters.KeepCasting = 1

#
#    AnimusForge.Curriculum.Party.*
#        Which party seats have a character, and their roles.

#   percent: tank, healer, damage dealers instead of drawn roles
AnimusForge.Curriculum.Party.ClassicChance = 50
#   drawn roles: percent tanks, healers, the rest damage dealers
AnimusForge.Curriculum.Party.RoleTankChance = 25
AnimusForge.Curriculum.Party.RoleHealerChance = 25
#   damage dealers: a non-tank teammate's damage taken
AnimusForge.Curriculum.Party.TeammateDamageTakenDps = 0.5
#   tanks and healers
AnimusForge.Curriculum.Party.TeammateDamageTakenProtector = 1.0
#   healers: effective healing, fraction of its health
AnimusForge.Curriculum.Party.TeammateHealing = 2.0
#   healers: what keeping the others up pays (TeammateHealing, Raid.KeepUp above half) while no Protect goal is
#   held, as a share of the full; 1 pays it whatever the goal
AnimusForge.Curriculum.Party.HealOffGoal = 1.0
#   a party's or raid's tank: its damage dealt, as a share of a damage dealer's pay for it (a healer's is never paid)
AnimusForge.Curriculum.Party.TankDamageShare = 0.25
#   tanks: per enemy on a non-tank teammate, per decision
AnimusForge.Curriculum.Party.TankLoseTeammate = 0.02
#   damage dealers and healers beside a living teammate that holds the pull: per enemy on the seat, per decision --
#   the enemies are the tank's to take, and the seat that draws them is charged for it
AnimusForge.Curriculum.Party.PulledThreat = 0.004
AnimusForge.Curriculum.Party.TeammateDeath = 3.0

#
#    AnimusForge.Curriculum.Raid.*
#        Raids: synthetic pulls sized to the raid, and each role paid for its own part.

#   tanks (party and raid, where no owner encounter pays it): per enemy on the tank, per decision
AnimusForge.Curriculum.Raid.TankHold = 0.015
#   the party's tank is charged per enemy on somebody else, per decision
AnimusForge.Curriculum.Raid.TankLoose = 0.006
#   a party's damage dealers: their damage on the tank's target times TankTarget, and PulledOff per enemy they took
#   off the tank, per decision
AnimusForge.Curriculum.Raid.TankTarget = 0.3
AnimusForge.Curriculum.Raid.PulledOff = 0.004
#   a party's damage dealers and healer: per enemy on them while the tank has not engaged, per decision (a cost)
AnimusForge.Curriculum.Raid.EarlyPull = 0.01
#   healers (party and raid): per group member above 50% health per decision, the same charged per member below 35%
AnimusForge.Curriculum.Raid.KeepUp = 0.0002
#   healers, party and raid: healing cast that landed on nobody's missing health, as a share of the healer's health,
#   charged at this share of what effective healing pays (Party.TeammateHealing)
AnimusForge.Curriculum.Raid.Overheal = 0.5
#   tanks, party and raid: per decision in a fight in the spec's tanking stance, form or aura (Defensive Stance, Bear
#   Form, Righteous Fury, Frost Presence)
AnimusForge.Curriculum.Raid.TankStance = 0.001
#   party and raid: per decision in a fight with an enemy within IdleReach yards and nothing served, neutral,
#   damaging or healing for IdleMs (ms)
AnimusForge.Curriculum.Raid.Idle = 0.001
AnimusForge.Curriculum.Raid.IdleMs = 4000
AnimusForge.Curriculum.Raid.IdleReach = 40.0

#
#    AnimusForge.Curriculum.Duel.*
#        The range the approach shaping aims for.

#   the range the approach shaping aims for, melee specs
AnimusForge.Curriculum.Duel.MeleeRange = 3.5
#   ... ranged specs
AnimusForge.Curriculum.Duel.RangedRange = 25.0

#
#    AnimusForge.Curriculum.Difficulty.*
#        How hard the combat and role drills' opponents are, per class and role. Evaluations spread their seeds over
#        every tier.

#   a class in a role moves up a tier when it wins (kills without dying) this share of Window fights at its tier ...
AnimusForge.Curriculum.Difficulty.RaiseAbove = 0.9
#   ... and down below this share
AnimusForge.Curriculum.Difficulty.LowerBelow = 0.6
AnimusForge.Curriculum.Difficulty.Window = 200
#   percent of training fights drawn from a lower tier, so none is forgotten
AnimusForge.Curriculum.Difficulty.ReviewChance = 25
#   percent drawn one tier above that class and role's own, which do not count towards moving it: an evaluation scores
#   every tier, so nothing should be met there for the first time
AnimusForge.Curriculum.Difficulty.StretchChance = 10
#   duel: the share of fights against something that casts, and of those, the share against something that puts a
#   hazard on the ground. The duel's own pool is default-AI creatures, which never cast at all, so at 0 the duel
#   teaches nothing about interrupting, dispelling or stepping out of anything -- all of it waits for the pack
#   stage, where it competes with learning to fight several enemies at once
AnimusForge.Curriculum.Difficulty.CasterChance = 40
#   the outcome terms scale with the tier: a win (kill, clear, health kept) is multiplied by 1 + TierScale x tier and
#   a loss (death, timeout, overtime) divided by it, in the duel, the packs, the raids and the endurance run's pulls.
#   A tier-0 fight is unchanged; at tier 6 a kill pays 2.5x and a death costs 0.4x, so a hard fight is worth
#   attempting and the score no longer falls as the ladder climbs. 0 keeps every tier flat
AnimusForge.Curriculum.Difficulty.TierScale = 0.25

#
#    AnimusForge.Curriculum.Instance.*
#        Whole dungeon wings (the party stages): the seats spawn at the instance's front door and find their own way to
#        the wing's last boss; no route, waypoint or path is paid or told (vision-only movement, 2026-10-08).

#   the rung's tier scale (Difficulty.TierScale) is capped at this tier: a ladder of twenty bosses would otherwise pay
#   a top kill 5.75x where the pool ladders stop at 2.5x
AnimusForge.Curriculum.Instance.MaxTierScale = 6
#   whole dungeon wings (the Wing ladder): each trash creature killed and the wing's boss (x the rung), each seat's
#   death and each wipe (/ the rung); the WingWipes-th wipe ends the episode (2: the first is scored and the party
#   rises at the entrance, the second ends the run -- no stage ends at the first death, and the Deadmines' bar is at
#   most one wipe; the next run starts in a fresh instance with the dungeon reset). In a wing the rung's tier is the
#   support ladder's (WING_RUNGS: rung / 3, 0 at the most support to 4 at the evaluation's own conditions)
AnimusForge.Curriculum.Instance.WingTrashKill = 1.0
AnimusForge.Curriculum.Instance.WingBoss = 25.0
#   each dungeon boss killed on the way to the wing's last (times the tier scale)
AnimusForge.Curriculum.Instance.WingMidBoss = 8.0
AnimusForge.Curriculum.Instance.WingDeath = 3.0
AnimusForge.Curriculum.Instance.WingWipe = 5.0
AnimusForge.Curriculum.Instance.WingWipes = 2
#   per second once WingStallGraceMs (ms) pass with no kill and nothing fighting the party (Idle, a Cost at its full
#   price from the first step)
AnimusForge.Curriculum.Instance.WingStall = 0.1
AnimusForge.Curriculum.Instance.WingStallGraceMs = 60000
#   whole dungeons: the stall charge on every seat but the tank, as a share of the tank's (the tank decides when to
#   move on)
AnimusForge.Curriculum.Instance.WingStallOthers = 0.2
#   whole dungeons: paid to every seat for each fight started with every living seat at WingReadyShare of its health
#   and mana (ReadyPull, an Outcome: the party's rest discipline), at most once a run, x the tier scale
AnimusForge.Curriculum.Instance.WingEngage = 1.0
AnimusForge.Curriculum.Instance.WingReadyShare = 0.8
#   the clock out costs this times the share of the dungeon left uncleared (the creatures not killed; / the tier scale)
AnimusForge.Curriculum.Instance.WingTimeout = 30.0
#   the dungeon curriculum's party stages (D2, D3): a run that killed every creature of its full clear and the last
#   boss (Clear, x the tier scale); every second of a run (StepCost, the clock)
AnimusForge.Curriculum.Instance.WingClear = 25.0
AnimusForge.Curriculum.Instance.WingClock = 0.002
#   the difficulty ladder: each rung fixes the level lift and the wipes to spare; WingProbe of training runs are
#   probes and only they measure the policy: once WingRungRuns probes have made WingRungTarget of the dungeon on
#   average it steps down; it never steps back on a score (a harder rung scores lower by design), and warns in
#   `forge status` and the log when the probes stay under a floor for three reads; a cluster's host decides for all
AnimusForge.Curriculum.Instance.WingProbe = 0.2
AnimusForge.Curriculum.Instance.WingRungRuns = 40
AnimusForge.Curriculum.Instance.WingRungTarget = 0.6
#   the rung a run starts on (the ladder is not saved: a resumed run names the rung it had reached)
AnimusForge.Curriculum.Instance.WingRungStart = 0
#   food and drink each seat brings into a whole dungeon
AnimusForge.Curriculum.Instance.WingSupplies = 60
#   log a line for each wipe in a whole dungeon: where, what was fighting the party, who died in what order
AnimusForge.Curriculum.Instance.WingTrace = 1
#   per second for each hostile creature on the party beyond WingCrowdFree (a pack): a pull run into the next
AnimusForge.Curriculum.Instance.WingCrowd = 0.15
AnimusForge.Curriculum.Instance.WingCrowdFree = 4
#   per second a seat other than the tank is further than WingStrayYards from it, WingStray (Lost, a Cost: stay with
#   the leader)
AnimusForge.Curriculum.Instance.WingStray = 0.02
AnimusForge.Curriculum.Instance.WingStrayYards = 25.0
#   per second a seat is dead or walking back from the entrance after a rise (Away, a Cost, as C3's Combat.Away); a seat
#   walking back is never also charged WingStray, and the leader it keeps with is the stand-in when it leads, else the
#   tank
AnimusForge.Curriculum.Instance.WingAway = 0.02
#   a sight stage's goal places in a dungeon (SeenPlaces) are what the seat discovered: the hostiles it saw (where it
#   last saw them, alive as last seen), its mental map's frontier and its leader within the minimap's range
#   (PartyFollow.MinimapYards) -- never a live pack's or boss's position, a route or a layout

#   every stage, per decision: the bot's effective healing on itself plus what its own absorbs soaked and damage-taken
#   reductions prevented on itself, as a fraction of its health; below every DamageTaken so it never pays to be hit
#   paid once when the goal the seat holds is reached (a goal is a kind and a target: fight, control, recover,
#   protect, position, prepare, travel_to, loot, gather, interact, rest -- the enemy it named is dead, the friend is
#   healthy, the place is reached, the objective done), not for holding it: paying per decision spent in a goal made
#   standing at range the stage's second largest earner. Replaced Goals.Match, which paid on first holding one
AnimusForge.Curriculum.Goals.Reached = 0.05
#   every stage with a goal head, per change of a seat's goal: Match is paid once per goal held, so without this a
#   head that switched at every choice was paid for the churn. A little more than a match, so a change of goal has
#   to be worth it on the stage's own terms
AnimusForge.Curriculum.Goals.Switch = 0.15
#   closing on the goal held, potential-based (Progress x (gamma x phi' - phi), phi in [-1, 0]): yards to its place
#   over 60, the named enemy's health, the seat's own health and mana, the friend's health. Gamma is the learner's
AnimusForge.Curriculum.Goals.Progress = 0.5
AnimusForge.Curriculum.Goals.ProgressGamma = 0.999
#   what reaching a goal is worth, by what it achieved (Reached stays for the kinds with no value of their own):
#   a named enemy dead, one held in crowd control, Recover/Rest by the share of health and mana restored since the
#   choice, a friend brought back up, a place reached
AnimusForge.Curriculum.Goals.FightValue = 0.3
AnimusForge.Curriculum.Goals.ControlValue = 0.2
AnimusForge.Curriculum.Goals.RecoverValue = 1.0
AnimusForge.Curriculum.Goals.ProtectValue = 1.0
#   Protect is also reached by keeping its friend above half health while it is attacked for this long (ms), as
#   well as by healing it back above 70%
AnimusForge.Curriculum.Goals.ProtectHoldMs = 5000
AnimusForge.Curriculum.Goals.TravelValue = 0.1
#   the secondary goal held beside the primary: paid this share of what the primary would be (reaching it, closing
#   on it), and charged Secondary every decision it is held
AnimusForge.Curriculum.Goals.SecondaryShare = 0.5
AnimusForge.Curriculum.Goals.Secondary = 0.002
#   every arena with a director, per decision a seat spends fighting the enemy its director called, while one is
#   called and alive. Compliance shaping: an order is meant to be followed because following it wins fights, but a
#   channel that correlates with nothing cannot bootstrap into that. stage15_arena ran 30M steps with the order
#   paying nothing and order_focus_kept sat at chance the whole way, so the director's calls changed nothing in the
#   world and it never left exploration. The same job Goals.Reached does for the goal head; anneal towards 0 once
#   order_focus_kept holds up without it. The director itself never earns this -- it is taken back out of its own
#   reward, or it would learn to call whoever its seats were already fighting.
#   Small because a per-decision term adds up over a fight: at 0.01 it earned 5.01 an episode, 23.7% of gross and
#   level with the kill and the death, which would buy tunnel vision on the called target. At 0.001 full compliance
#   is worth about 0.5, a tenth of the kill
#   every arena whose director may name a place: paid once to a seat that arrives where it was sent, and not
#   again for PlaceCooldownMs. Never per decision -- a per-decision payment for standing in the right spot is
#   the shape that made the focus nudge 23.7% of gross before it was cut, and it could be farmed by stepping
#   over the edge of the radius and back
#   yards: close enough to the called place to count as having arrived
#   milliseconds before the same seat can be paid for arriving again
#   how far a called place sits off its anchor, at each ring. These two numbers are all that changes between
#   an arena and a continent: the director's thirteen place actions mean the same thing at any scale
#   how often the director's clock gives it a turn to speak (decisions; 10 is 2.5 s). Events give it one at once: a
#   member down or newly badly hurt, a new enemy in the fight, the focus dead. A turn allows four calls for a group
#   and eight for a raid, until the director holds
#   below this share of its health a member counts as badly hurt, for the director's event
#   a member order stands this many decisions before the same source can replace it for free; one replaced sooner costs
#   the director OrderChurn, and any live order it replaces costs OrderChange. Nothing stops the call: it learns to
#   let orders stand
AnimusForge.Curriculum.Support.SelfHealing = 0.5
#   per fraction of the mana pool spent on healing. Healing is worth what it restores for what it costs, and the cost
#   was never priced: an effective heal of 3% of a health bar cost the same as one of 20%, so choosing a cheaper rank
#   bought nothing and a heal over time could be stacked on a full bar for free. With it the objective is healing per
#   mana. Kept well below SelfHealing -- the failure to avoid is a seat that heals too little and dies
AnimusForge.Curriculum.Support.HealingMana = 0.1

#
#    AnimusForge.Curriculum.Actions.*
#        How often a seat may press the same button, as a player would. A paced action is masked until it may be
#        pressed again, so a policy cannot sit re-issuing an order every decision (a pet sent in 125 times an
#        episode, a cast started and stopped over and over). Spells keep their own cooldowns as well. 0 = no pace.

#   the same action again: spells, orders, consumables, targeting (ms)
AnimusForge.Curriculum.Actions.RepeatMs = 1000
#   the same movement order again (ms)
AnimusForge.Curriculum.Actions.MoveRepeatMs = 300
#   a cast the bot is in cannot be stopped before it has run this long (ms)
AnimusForge.Curriculum.Actions.StopCastMinMs = 500
#   a spell the bot stopped itself cannot be started again for this long (ms)
AnimusForge.Curriculum.Actions.RecastAfterStopMs = 2000
#   per press of the same action past the free ones within RepeatWindowMs: pressing one button over and over,
#   however far apart the presses are paced (how often the seat acts overall is not charged; movement orders are
#   always free)
AnimusForge.Curriculum.Actions.Repeat = 0.03
#   the window the presses of one action are counted in (ms)
AnimusForge.Curriculum.Actions.RepeatWindowMs = 10000
#   presses of one action within the window that cost nothing
AnimusForge.Curriculum.Actions.RepeatFree = 3
#   per quarter turn a turn, a pitch or a bearing takes back of the one before it, weighed by how recent that was
#   (e^(-dt / Options.JitterDecayMs)), and per facing mode taken back or start moments after a stop: steering that
#   does not commit, which on screen is a head twitching side to side, a flyer bobbing up and down, and feet that
#   zigzag
AnimusForge.Curriculum.Actions.Jitter = 0.05
#   presses with intent: every spell and step is judged against the goal the seat holds, and one that works against
#   it (damage off the focus under Fight, a nuke while Recovering, a step that opens the gap to the wanted range) is
#   charged this. Serving presses are free
AnimusForge.Curriculum.Actions.Aimless = 0.02
#   aimless presses by cause, each its own price (StageScenario::JudgePress): harm on an enemy the goal does not
#   name, an area spell missing it, casting under Position once in range, harm under a goal that is not fighting
#   with nothing attacking, help on someone else while fighting, a step away from where the goal wants the seat,
#   selecting or sending the pet at an enemy the goal does not name when it is hurting nobody, eating or drinking
#   with that resource nearly full, a trap with nothing near, an aspect/stance/form changed with nothing changed (and
#   back within ten seconds), a ranged seat moving about a fight it could stand and shoot in
AnimusForge.Curriculum.Actions.Aimless.OffFocus = 0.02
AnimusForge.Curriculum.Actions.Aimless.AoeMissed = 0.02
AnimusForge.Curriculum.Actions.Aimless.InRangeCast = 0.02
AnimusForge.Curriculum.Actions.Aimless.UnprovokedHarm = 0.02
AnimusForge.Curriculum.Actions.Aimless.HelpOffGoal = 0.02
AnimusForge.Curriculum.Actions.Aimless.StepAway = 0.02
AnimusForge.Curriculum.Actions.Aimless.TargetSwitch = 0.04
AnimusForge.Curriculum.Actions.Aimless.PetOffGoal = 0.04
AnimusForge.Curriculum.Actions.Aimless.ConsumeNotNeeded = 0.03
AnimusForge.Curriculum.Actions.Aimless.TrapNoEnemy = 0.03
AnimusForge.Curriculum.Actions.Aimless.ModeFlip = 0.03
AnimusForge.Curriculum.Actions.Aimless.ModeReverse = 0.06
AnimusForge.Curriculum.Actions.Aimless.NeedlessMove = 0.02
#   a taunt from a healer or damage dealer beside a living tank
AnimusForge.Curriculum.Actions.Aimless.TauntOffRole = 0.15
#   a tank's stance, form, aura or presence from a healer or damage dealer beside a living tank
AnimusForge.Curriculum.Actions.Aimless.TankModeOffRole = 0.04
#   a press that failed for something the seat controls: facing, range, sight, a cast on the move, power
AnimusForge.Curriculum.Actions.Aimless.CastFailed = 0.02
#   a sight block press the world refused: an entity gone or out of reach, the wrong kind, no key item
AnimusForge.Curriculum.Actions.Aimless.ActRefused = 0.02
#   every aspect, stance, form or presence changed; every food or drink consumed
AnimusForge.Curriculum.Actions.ModeSwitch = 0.01
AnimusForge.Curriculum.Actions.SupplySpent = 0.02
#   health (eating) or mana (drinking) at or above which consuming is ConsumeNotNeeded
AnimusForge.Curriculum.Actions.ConsumeFullPct = 85
#   every press but the no-op costs this, a tenth of an aimless one: when nothing needs doing, doing nothing wins
AnimusForge.Curriculum.Actions.Effort = 0.004
#   per second spent moving in a fight while already at the range the spec wants, with nothing underfoot, the focus
#   standing still and no from-behind spell to get into position for: the shuffle that reads as a bot
AnimusForge.Curriculum.Actions.Fidget = 0.01
#   how long Fidget's and the needless-move charge's conditions must hold before they are charged (ms): running into
#   the band and stopping within it is not fidgeting, and a range flickering at its edge is not charged each flicker
AnimusForge.Curriculum.Actions.SettleGraceMs = 500
#   how much a step must close or open the gap to the wanted range to count as serving or aimless (yards)
AnimusForge.Curriculum.Actions.IntentSlackYards = 0.5
#   a stance, form, presence, aspect, aura, seal, armor or pet stance holds this long before another change of its
#   kind (ms)
AnimusForge.Curriculum.Actions.ModeLockMs = 5000

#
#    AnimusForge.Curriculum.Options.*
#        Description: How long a durative action may run before the seat has to choose again (ms). One press of
#                     one stands for many decisions: resting until health and mana are back, or holding an
#                     interrupt for the target's next cast. They also end on their own conditions, and any other
#                     action the policy takes cancels them. (The move block's keys are held, not options.)
#        Default:     30000 / 10000 / 2500
#
AnimusForge.Curriculum.Options.RestMaxMs = 30000
AnimusForge.Curriculum.Options.HoldInterruptMs = 10000
#   how fast a turn or pitch rate, a climb or the feet stop weighing on a press that reverses them (ms;
#   Actions.Jitter, MoveControls::Press): its weight is e^(-dt / this): 0.45 two seconds on, 0.30 at three, 0.14 at
#   five, so a slow weave costs and a deliberate correction little. Replaced a 1500 ms window charged in full and
#   free past it
AnimusForge.Curriculum.Options.JitterDecayMs = 2500

#   Ground effects: damage from something standing on the ground rather than aimed at the seat (a fire pool, a poison
#   cloud, a consecration), charged per fraction of maximum health ON TOP of DamageTaken, which already charges it
#   once as damage. This is the damage a seat could have walked out of, and the only term that pays for moving its
#   feet -- without it, standing in fire costs exactly what standing anywhere else costs. Reads zero wherever nothing
#   puts anything on the ground, which is most of the curriculum today and none of a dungeon.
AnimusForge.Curriculum.Hazards.Damage = 0.5
#   per second standing in one, whether or not it has ticked yet. The damage alone is small, late and noisy (it
#   arrives after the decision that put the seat there); the seconds are immediate and describe the behaviour, as
#   Spacing does for a ranged spec caught in melee
AnimusForge.Curriculum.Hazards.Standing = 0.15
#   at most this much an episode, both hazard terms together. Melee have to stand in melee: a hazard under the enemy
#   is a real trade, and an uncapped charge teaches a seat to leave the fight, which is worse than standing in fire
AnimusForge.Curriculum.Hazards.Max = 3.0
#
#    AnimusForge.Curriculum.Markers.*
#        The movement stages' markers (MarkerEncounter; move1_controls): a place on open ground to stop on, then
#        the next, MarkersMin to MarkersMax an episode. Arrive is paid per marker the seat stopped on -- no forward,
#        back, strafe or vertical key held, no jump, on the ground, the feet moved under StopMoved yards since the
#        last decision, inside the rung's radius. Progress (the straight-line distance, per leg) and Facing (the
#        cosine of the marker's bearing from the facing) are potential shaping and fade with the stage's shaping.
#        The ladder (per class and build, Difficulty.*) has Rungs rungs; each moves the furthest distance from
#        DistanceFirst to DistanceLast (the nearest is always DistanceMin), the bearing span either side of the
#        facing from BearingFirst to BearingLast degrees, and the stop radius from RadiusFirst to RadiusLast yards.
#        stop_distance averages the
#        distance at every stop within StopNear yards of the marker. An arena with a fixed objective (move1_controls'
#        Stockades hallway: ArenaDefinition::Objective) has none of the ladder: one marker an episode, always the same
#        place, stopped on inside the arena's ObjectiveRadius. StepCost is the time a run takes (per 50 ms, so about
#        0.04 a second): M1 is "as fast as possible", and it is paid in full, never on the noise ladder.
AnimusForge.Curriculum.Markers.Arrive = 3.0
AnimusForge.Curriculum.Markers.StepCost = 0.002
AnimusForge.Curriculum.Markers.Death = 3.0
AnimusForge.Curriculum.Markers.Progress = 1.0
AnimusForge.Curriculum.Markers.Facing = 0.25
AnimusForge.Curriculum.Markers.StopMoved = 0.05
AnimusForge.Curriculum.Markers.StopNear = 10.0
#   arriving is on the marker's own floor too: the unit within ArriveRise yards of its height
AnimusForge.Curriculum.Markers.ArriveRise = 2.0

#
#    AnimusForge.Curriculum.Respawn.*
#        Death in an instance (dungeon-curriculum I4; move4_follow on): a seat that dies is out for DelayMs, then stands
#        up alive at full health and power at the instance's entrance and plays on -- no graveyard, ghost or corpse
#        run, no teleport to the party, no end to the episode -- and walks back on the controller. It has rejoined
#        once within RejoinYards of the party's leader (of the living party's centroid while the leader is down).
AnimusForge.Curriculum.Respawn.DelayMs = 10000
AnimusForge.Curriculum.Respawn.RejoinYards = 15.0

#
#    AnimusForge.Curriculum.PartyFollow.*
#        The party follow (move4_follow; dungeon-curriculum I5): a party keeps with a leader walking a dungeon's route
#        from the door through its bosses' places, stopping StopSecondsFirst (rung 0) to StopSecondsLast (top rung)
#        at each. The leader walks below WalkRungs; from SuddenFromRung it also stops unannounced for
#        SuddenStopMinMs-SuddenStopMaxMs every SuddenGapMin-SuddenGapMax s; from BackStepFromRung BackStepChance
#        percent of those stops step back BackStepYards first. A leg the leader is stuck on for GiveUpMs is given up
#        for the next stop. CastShare percent of training episodes give the leader to a frozen checkpoint
#        (cast.agents.leader; 0 until one exists that walks dungeons).
#        Paid: Kept per second within [BandMin, BandMax] yd of the leader (Outcome); Regroup once per leader stop of
#        RegroupMinStopMs or more, on coming into the band, x (1 - seconds/RegroupWindow) (Outcome); Lost per second
#        past LostYards and Blocking per second within BlockYards ahead of a moving leader, inside BlockHalfAngle
#        degrees of its facing (Costs); Death per death (Cost). Party members within MinimapYards are the minimap's
#        dots (the party frames block).
AnimusForge.Curriculum.PartyFollow.BandMin = 3.0
AnimusForge.Curriculum.PartyFollow.BandMax = 10.0
AnimusForge.Curriculum.PartyFollow.LostYards = 40.0
AnimusForge.Curriculum.PartyFollow.Kept = 0.02
AnimusForge.Curriculum.PartyFollow.Lost = 0.02
AnimusForge.Curriculum.PartyFollow.Regroup = 0.5
AnimusForge.Curriculum.PartyFollow.RegroupWindow = 20.0
AnimusForge.Curriculum.PartyFollow.RegroupMinStopMs = 2000
AnimusForge.Curriculum.PartyFollow.Blocking = 0.05
AnimusForge.Curriculum.PartyFollow.BlockYards = 2.5
AnimusForge.Curriculum.PartyFollow.BlockHalfAngle = 45.0
AnimusForge.Curriculum.PartyFollow.Death = 3.0
AnimusForge.Curriculum.PartyFollow.MinimapYards = 60.0
AnimusForge.Curriculum.PartyFollow.WalkRungs = 1
AnimusForge.Curriculum.PartyFollow.SuddenFromRung = 2
AnimusForge.Curriculum.PartyFollow.BackStepFromRung = 3
AnimusForge.Curriculum.PartyFollow.StopSecondsFirst = 8.0
AnimusForge.Curriculum.PartyFollow.StopSecondsLast = 3.0
AnimusForge.Curriculum.PartyFollow.SuddenStopMinMs = 1000
AnimusForge.Curriculum.PartyFollow.SuddenStopMaxMs = 4000
AnimusForge.Curriculum.PartyFollow.SuddenGapMin = 12.0
AnimusForge.Curriculum.PartyFollow.SuddenGapMax = 30.0
AnimusForge.Curriculum.PartyFollow.BackStepYards = 4.0
AnimusForge.Curriculum.PartyFollow.BackStepChance = 30
AnimusForge.Curriculum.PartyFollow.GiveUpMs = 6000
AnimusForge.Curriculum.PartyFollow.CastShare = 0

#
#    AnimusForge.Curriculum.Seek.*
#        The seek stage (move2_seek, SeekEncounter): one real object (a chest, crate, barrel, sack or strongbox) in one
#        of the Stockades' rooms, found by sight -- the camera's objective flag marks it only in line of sight; there is
#        no compass. Arrive (Outcome) is paid on stopping within the arena's radius (3 yd) of the object, on its floor
#        (within ArriveRise yards of its height). StepCost is per 50 ms (a whole 300 s episode costs 3, what Arrive
#        pays); Death (6) costs more than any clock. Stuck and Wall are the ground course's noise prices (WallSlide as
#        MarkerGround's), charged from the first step at their own fixed price, off the cost ladder. Sighting (the
#        first frame showing the object), NewGround (each NewGroundCell-yard cell of floor first walked onto before the
#        object is found) and RoomSeen (each room whose floor a frame first shows, RoomSeenRays cast rays or more, by
#        the episode's own bookkeeping) are training-only shaping and fade with the stage's shaping. The placement
#        ladder follows the fade's rungs: the hallway (a hallway point HallwayNearest to HallwayFurthest yards off, in
#        sight of the seat), a front cell's doorway (DoorwayInside yards in from its opening, up to DoorwayDeeper more
#        and DoorwaySpread either side), a front cell, then deep; each rung keeps CarryShare of the one below, and its
#        episodes last RungSeconds0 to 3. A room's object is placed at one of Attempts uniform points of its floor whose
#        vmap floor is within FloorTolerance yards of the room's and that has Clearance yards of room along each axis at
#        knee height, else at the room's centre.
#        Room goals (M2 goals plan, 2026-10-09): Goals 1 offers the goal head the rooms the seat's own frames showed
#        (a frame with GlimpseRays floor rays or more on a room) as place targets, six slots bound in the order of the
#        glimpses, and its mental map's nearest frontier as the way on, at placement rungs from GoalsFromRung up; 0
#        offers none and pays no aid (the old behaviour; a temporary switch for the experiment, deleted afterwards). A
#        room is checked when the seat stood in it EnterDwellMs or CheckedShare of its floor cells (3 yd) were hit by
#        this episode's rays. RoomGoal (paid once when a held room goal's room becomes checked) and RoomSwitch (charged
#        when a room goal is given up for another) are Aid: paid times max(0, 1 - progress / AidUntil), progress being
#        the share of the stage's step budget, and not in the score. Return (Cost, fixed price, in the score) is
#        charged for entering a room visited before after ReturnAwayMs outside its polygon by ReturnAwayYards or more.
#        Cell goals (free choice goals, 2026-10-09): GoalSource 1 (the default) makes the goal a block (4 yd) of the
#        seat's own mental-map crop, chosen by the learner's pointer head, instead of a room; a plan is up to four of
#        them in order, and the sim latches each block's point at the choice. GoalSource 0 keeps the room slots (a
#        temporary switch for the A/B, deleted with the loser); it only matters with Goals 1. A cell goal is reached
#        within CellReach yards (2D) of its point and CellRise yards of its height; a choice within CellSame yards of
#        the goal held and not ended is that goal chosen again, free; a goal whose best distance gains less than
#        CellPatienceYards in CellPatienceMs is lost. CellGoal (once per goal reached, only for one chosen at least
#        CellMinYards away on a block the seat had not stood on) and CellProgress (per yard of new best closeness, the
#        same blocks) are Aid, times the aid scale; CellSwitch (a cell goal given up for another), CellLost (a cell goal
#        lost) and CellStale (a block chosen that the seat had stood on) are Cost at fixed prices, in the score.
#        RoomGoal and RoomSwitch are paid at GoalSource 0 only.
AnimusForge.Curriculum.Seek.Arrive = 3.0
AnimusForge.Curriculum.Seek.StepCost = 0.0005
AnimusForge.Curriculum.Seek.Death = 6.0
AnimusForge.Curriculum.Seek.ArriveRise = 2.0
AnimusForge.Curriculum.Seek.Sighting = 0.5
AnimusForge.Curriculum.Seek.NewGround = 0.004
AnimusForge.Curriculum.Seek.NewGroundCell = 4.0
AnimusForge.Curriculum.Seek.Stuck = 0.02
AnimusForge.Curriculum.Seek.Wall = 0.02
AnimusForge.Curriculum.Seek.WallSlide = 0.5
AnimusForge.Curriculum.Seek.Attempts = 24
AnimusForge.Curriculum.Seek.FloorTolerance = 2.0
AnimusForge.Curriculum.Seek.Clearance = 0.8
