#
# GENERAL
#

USER_CONF_PATH=/azerothcore/apps/docker/config-docker.sh
DATAPATH=/azerothcore/env/dist/data

#
# COMPILER
#

# Forge: the sim host is a throughput build. ASSERT is the core's own macro rather than the standard
# assert, so Release keeps every check and loses only -g -- which on this tree is a third of a gigabyte
# of debug info in the binary and a much slower link once LTO is on. Set RelWithDebInfo here when a
# backtrace matters more than the link time.
CTYPE=Release
CSCRIPTS=static
AC_CCACHE=true

#
# SIMPLE RESTARTER
#
AC_RESTARTER_BINPATH=
AC_RESTARTER_BINFILE=
AC_RESTARTER_WITHGDB=
